# Which AI provider to use: "groq" (free tier) or "claude"
LLM_PROVIDER=groq

# Groq: free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude: key from https://console.anthropic.com (only needed if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# YouTube song search in the Music panel (optional, free)
# YouTube: Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
# Optional 2-letter country code (e.g. IN, US, GB): search only returns songs playable there
MUSIC_REGION=
